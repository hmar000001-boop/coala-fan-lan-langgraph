    AUTOGEN["AutoGen\nAgents · events · messages · tools"]
    AGENTSCOPE["AgentScope\nAgent · message · model · tool interfaces"]
    OPENHANDS["OpenHands\nEvent-oriented agent–computer loop"]
  end
  subgraph R3["Workflow and governed run state"]
    MS["Microsoft Agent Framework\nWorkflow · run state · approvals"]
    OAI["OpenAI Agents SDK\nRun state · handoff · guardrail · resume"]
  end
  subgraph R4["Operating-system and resource boundary"]
    AIOS["AIOS\nScheduling · context · memory · storage · access"]
  end
