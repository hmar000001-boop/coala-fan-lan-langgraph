flowchart TB
  accTitle: Corpus strata and bridge records
  accDescr: Three principal corpus strata are historical architecture families, general runtime families, and mechanism-focused modern records. Explicit bridge records are separately cross-indexed and may overlap with other layers.
  subgraph H["Corpus H · 10 historical architecture families"]
    H1["ACT-R · Soar · CLARION · LIDA"]
    H2["Hearsay-II · BDI · MIDCA"]
    H3["ICARUS · EPIC · Sigma"]
  end
  subgraph M["Corpus M · modern layer"]
    subgraph MA["M-A · 8 general runtime families"]
      A1["Letta · LangGraph · AutoGen · AgentScope"]
      A2["OpenHands · Microsoft Agent Framework"]
      A3["OpenAI Agents SDK · AIOS"]
    end
    subgraph MB["M-B · 42 mechanism-focused records"]
      B1["Memory · failure recovery · workspace"]
      B2["Commitment · meta-control · skills"]
      B3["Resources · uncertainty"]
    end
  end
  subgraph BR["Corpus B · explicit historical–modern bridges"]
    C1["CoALA · LLM-ACTR"]
    C2["Bootstrapping Cognitive Agents · hybrid BDI–LLM"]
  end
  H -. "historical source relation" .-> BR
  BR -. "documented integration / lineage" .-> MA
  BR -. "cross-indexed mechanism evidence" .-> MB
  classDef hist fill:#EAF4FB,stroke:#1A4A8A,color:#1C1C1E
  classDef modern fill:#EEF7EE,stroke:#27AE60,color:#1C1C1E
  classDef bridge fill:#F0F0FF,stroke:#5B4FBE,color:#1C1C1E
  class H1,H2,H3 hist
  class A1,A2,A3,B1,B2,B3 modern
  class C1,C2 bridge
