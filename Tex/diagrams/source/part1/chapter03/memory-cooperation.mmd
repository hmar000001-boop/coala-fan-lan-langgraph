flowchart TB
    accTitle: Memory relationships around working memory
    accDescr: Working memory is the active hub. It can receive observations, information from long-term memory, and new information generated by reasoning. Procedural memory supplies the procedures used by the agent.

    OBS["Current observations"] --> WM["Working memory<br/>Active goals, inputs, and results"]
    EPI["Episodic memory"] --> WM
    SEM["Semantic memory"] --> WM
    PROC["Procedural memory<br/>Model weights and agent code"] --> OPS["Procedures for agent operations"]
    OPS --> WM
    WM --> LLM["LLM reasoning"]
    LLM --> WM
    WM --> EPIWRITE["Experience may be retained"]
    EPIWRITE --> EPI
    WM --> SEMWRITE["Inferred knowledge may be retained"]
    SEMWRITE --> SEM

    classDef active fill:#EAF4FB,stroke:#1A4A8A,color:#1C1C1E,stroke-width:2px;
    classDef retained fill:#EEF7EE,stroke:#27AE60,color:#1C1C1E,stroke-width:1.5px;
    classDef process fill:#F4F4F4,stroke:#888888,color:#1C1C1E,stroke-width:1.5px;
    class WM active;
    class EPI,SEM,PROC retained;
    class OBS,OPS,LLM,EPIWRITE,SEMWRITE process;
